VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# "true"  → usa o Supabase (fonte da verdade; requer as duas variáveis acima).
# "false" → usa armazenamento local do navegador (localStorage), SEM dados
#           fabricados: começa vazio e guarda o que você cadastrar/importar.
VITE_USE_SUPABASE=false

# Trava de build (vite.config.ts): `npm run build` FALHA quando
# VITE_USE_SUPABASE != "true", para não publicar em produção um app que grava
# só no navegador. Para builds de demonstração/CI sem backend, libere com:
#   VITE_ALLOW_LOCAL_BUILD=true
# Nunca defina isso no ambiente de produção (Vercel).
VITE_ALLOW_LOCAL_BUILD=false
